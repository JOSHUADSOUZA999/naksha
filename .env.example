# Copy to .env (same directory) and fill in. .env is gitignored.
#
#   cp .env.example .env
#
# Pick a model, set that provider's key. The provider is inferred from the model
# id — claude-* goes to Anthropic, gpt-*/o1/o3/o4 to OpenAI — so this is normally
# the only thing you change.
NAKSHA_INTENT_MODEL=claude-opus-5

# --- Anthropic -------------------------------------------------------------
# Create at https://platform.claude.com -> Settings -> API keys. The org needs API
# credits; a Claude Pro/Max subscription is billed separately and does not by
# itself grant API access.
#
# Alternative: install the `ant` CLI and run `ant auth login` for an OAuth profile,
# then leave this unset. A *set but empty* key outranks the profile and
# authenticates as empty, so delete the line rather than blanking it.
ANTHROPIC_API_KEY=

# --- OpenAI ----------------------------------------------------------------
# Create at https://platform.openai.com -> API keys.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible gateway (Azure, OpenRouter, a local
# server). Set NAKSHA_INTENT_PROVIDER=openai when the model id is not gpt-shaped.
# OPENAI_BASE_URL=

# --- Claude Code (no API key) ----------------------------------------------
# Runs against a Claude Pro/Max subscription through a local Claude Code install,
# via the Claude Agent SDK. Development only — it needs the `claude` CLI on the
# machine, spawns a process per call, and draws on subscription limits.
#
#   npm install -g @anthropic-ai/claude-code && claude   # log in once
#   pip install -e ".[claude-code]"
#   NAKSHA_INTENT_PROVIDER=claude_code
#
# Never inferred from a model id: claude-* always means the API, so this is only
# ever selected explicitly.
# NAKSHA_INTENT_PROVIDER=claude_code

# Override the inferred provider. Also needed for a model id the prefix table
# cannot place — a fine-tuned checkpoint, a renaming gateway, a local endpoint.
# NAKSHA_INTENT_PROVIDER=openai

# Optional. Set both to turn on Langfuse tracing; otherwise tracing is a no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Other overrides. Anything prefixed NAKSHA_ maps to a field on Settings.
NAKSHA_MAX_SCHEMA_RETRIES=2
